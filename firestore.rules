rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Exige el correo verificado del token (no un dato que haya que leer
    // de otro sitio): las cuentas de Google ya llegan con
    // `email_verified: true` desde el primer inicio de sesión, y las de
    // correo/contraseña lo consiguen tras verificar y refrescar el token
    // (`FirebaseAuthRepository.reloadUser`, que llama a `getIdToken(true)`
    // después de `reload()`; ver docs/security.md).
    function isVerified() {
      return request.auth.token.email_verified == true;
    }

    function isValidAmount(amount) {
      return amount is int
        && amount != 0
        && amount >= -100000000
        && amount <= 100000000;
    }

    function isValidDescription(text) {
      return text is string
        && text.size() >= 1
        && text.size() <= 200;
    }

    function isValidCategory(id) {
      return id in [
        'supermercado', 'restaurantes', 'transporte', 'suscripciones',
        'ocio', 'salud', 'hogar', 'nomina', 'otros'
      ];
    }

    function isValidSource(source) {
      return source in ['manual', 'naturalLanguage', 'demo', 'payroll'];
    }

    function isValidTransaction(data) {
      return data.keys().hasOnly([
          'amountCents', 'date', 'description', 'categoryId', 'source', 'createdAt'
        ])
        && data.keys().hasAll([
          'amountCents', 'date', 'description', 'categoryId', 'source', 'createdAt'
        ])
        && isValidAmount(data.amountCents)
        && data.date is timestamp
        && isValidDescription(data.description)
        && isValidCategory(data.categoryId)
        && isValidSource(data.source)
        && data.createdAt is timestamp;
    }

    match /users/{userId}/transactions/{txId} {
      allow read, delete: if isOwner(userId) && isVerified();
      allow create, update: if isOwner(userId) && isVerified()
        && isValidTransaction(request.resource.data);
    }

    function isValidGoalName(text) {
      return text is string
        && text.size() >= 1
        && text.size() <= 60;
    }

    // A diferencia de `isValidAmount` (que admite negativos, para un
    // gasto), los importes de una meta nunca son negativos: `targetCents`
    // además tiene que ser mayor que 0 (una meta sin objetivo no tiene
    // sentido), comprobado aparte en `isValidSavingsGoal`.
    function isValidGoalAmount(amount) {
      return amount is int
        && amount >= 0
        && amount <= 100000000;
    }

    function isValidSavingsGoal(data) {
      return data.keys().hasOnly([
          'name', 'targetCents', 'savedCents', 'deadline', 'createdAt'
        ])
        && data.keys().hasAll([
          'name', 'targetCents', 'savedCents', 'deadline', 'createdAt'
        ])
        && isValidGoalName(data.name)
        && isValidGoalAmount(data.targetCents) && data.targetCents > 0
        && isValidGoalAmount(data.savedCents)
        && data.deadline is timestamp
        && data.createdAt is timestamp;
    }

    // El máximo de 10 metas por usuario (`CreateSavingsGoal.maxGoalsPerUser`)
    // se valida en la aplicación, no aquí: estas reglas no limitan cuántos
    // documentos puede crear un usuario verificado, igual que ya pasa con
    // `transactions` (ver "Límites conocidos" en docs/security.md).
    match /users/{userId}/goals/{goalId} {
      allow read, delete: if isOwner(userId) && isVerified();
      allow create, update: if isOwner(userId) && isVerified()
        && isValidSavingsGoal(request.resource.data);
    }
  }
}
